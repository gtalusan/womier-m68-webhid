{
  "name": "m68-tools",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "m68-tools",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@m68/protocol": {
      "resolved": "packages/protocol",
      "link": true
    },
    "node_modules/m68ctl": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "m68ctl",
      "version": "0.1.0",
      "dependencies": {
        "@m68/protocol": "0.1.0"
      },
      "bin": {
        "m68ctl": "src/cli.js"
      }
    },
    "packages/protocol": {
      "name": "@m68/protocol",
      "version": "0.1.0"
    }
  }
}
